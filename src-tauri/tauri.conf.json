{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "二次风工作台",
  "version": "0.3.0",
  "identifier": "com.erci-feng.workbench",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run prepare:web",
    "beforeBuildCommand": "npm run prepare:web"
  },
  "app": {
    "windows": [
      {
        "title": "二次风工作台 · AI 小说创作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https: data: blob:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; connect-src 'self' https: http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    }
  }
}
